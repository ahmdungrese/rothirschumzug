rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isOfficeOrAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'admin' || getUserData().role == 'office');
    }

    // ─── customers ──────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isOfficeOrAdmin();
    }

    // ─── orders ─────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthenticated();

      // Create: Nur Admin und Büro dürfen neue Aufträge anlegen
      allow create: if isOfficeOrAdmin();

      // Update: invoiceNumber darf niemals geändert werden; Status & Protokolle aktualisierbar
      allow update: if isAuthenticated() &&
        (
          !('invoiceNumber' in resource.data) ||
          resource.data.invoiceNumber == null ||
          request.resource.data.invoiceNumber == resource.data.invoiceNumber
        );

      // Delete: Strengstens verboten für alle — stattdessen Status 'archived' nutzen
      allow delete: if false;
    }

    // ─── invoices (Rechnungen & Finanzen) ─────────────────────────
    // Strenger Schutz: NUR Admin & Büro dürfen Rechnungen lesen oder schreiben!
    // Teamleiter haben keinerlei Zugriff auf Rechnungsdaten in der Datenbank.
    match /invoices/{invoiceId} {
      // Lesen: Nur Admin und Büro
      allow read: if isOfficeOrAdmin();

      // Erstellen: Nur Admin und Büro
      allow create: if isOfficeOrAdmin();

      // Update: Nur Admin und Büro; Storno-Belege und vergebene Nummern unveränderlich
      allow update: if isOfficeOrAdmin() &&
        (!('isStorno' in resource.data) || resource.data.isStorno != true) &&
        (
          !('invoiceNumber' in resource.data) ||
          resource.data.invoiceNumber == null ||
          request.resource.data.invoiceNumber == resource.data.invoiceNumber
        );

      // Löschen: Nur für reine Entwürfe ohne invoiceNumber durch Admin/Büro
      allow delete: if isOfficeOrAdmin() &&
        (
          !('invoiceNumber' in resource.data) ||
          resource.data.invoiceNumber == null
        );
    }

    // ─── claims (Reklamationen & Schäden) ─────────────────────────
    match /claims/{claimId} {
      allow read: if isOfficeOrAdmin();
      allow write: if isOfficeOrAdmin();
    }

    // ─── system / settings ──────────────────────────────────────
    match /system/{docId} {
      allow read: if isAuthenticated();
      // Admins und Büro dürfen Zähler und Einstellungen aktualisieren
      allow write: if isOfficeOrAdmin();
    }

    // ─── activity_logs ───────────────────────────────────────────
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── users ──────────────────────────────────────────────────
    match /users/{userId} {
      // Nutzer dürfen ihr eigenes Dokument lesen; Admins alle lesen & schreiben
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if isAdmin();
    }
  }
}
